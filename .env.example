# Polly — environment variables
# Copy to .env (local) / set in the Lightsail deployment environment.
# NEVER commit a real .env. Placeholder values only below.

# ── Postgres (Supabase) ──────────────────────────────────────────
# Pooled connection (Supavisor, port 6543) — what the app uses at runtime.
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct connection (port 5432) — Prisma migrations / `prisma db push` only.
DIRECT_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ── Supabase Auth / API ──────────────────────────────────────────
# Public: safe to expose in the browser (RLS-gated).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-only: NEVER prefix with NEXT_PUBLIC_, never ship to the client.
# Bypasses RLS — only used for Auth-admin operations (src/lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Optional providers (leave blank until configured) ─────────────
# Phone OTP via Supabase Auth needs an SMS provider (configure the
# provider in the Supabase Dashboard → Authentication → Phone; the keys
# below are only needed if Polly itself ever sends SMS directly).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Google / Apple SSO are configured in the Supabase Dashboard
# (Authentication → Providers); no keys are needed in this file for them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
